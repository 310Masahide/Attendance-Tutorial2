<% if @overtime_request.errors.any? %>
  <%= turbo_stream.replace 'modal' do %>
    <%= render layout: 'shared/modal', locals: { title: '【残業申請の編集】' } do %>
      <%= render 'overtime_requests/form', overtime_request: @overtime_request, approvers: @approvers %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.update 'modal', '' %>
  <%= turbo_stream.replace "overtime_cell_#{@overtime_request.worked_on.strftime('%Y%m%d')}" do %>
    <%= render 'users/overtime_request_cell', worked_on: @overtime_request.worked_on, overtime_request: @overtime_request %>
  <% end %>
  <%= turbo_stream.update 'flash', partial: 'shared/flash_messages' %>
<% end %>
