<%# app/views/overtime_requests/new.html.erb %>
<h1>残業申請</h1>
<%= form_with(model: @overtime_request, url: user_overtime_requests_path(@user), local: true) do |f| %>
  <div class="form-group">
    <%= f.label :worked_on, "対象日" %>
    <%= f.date_field :worked_on %>
  </div>
  <div class="form-group">
    <%= f.label :reason, "理由" %>
    <%= f.text_area :reason, class: "form-control" %>
  </div>
  <%= f.submit "申請する", class: "btn btn-warning" %>
<% end %>
