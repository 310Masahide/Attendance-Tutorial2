<%# app/views/overtime_requests/_form.html.erb %>
<%= render 'shared/error_messages', object: @overtime_request %>
<%= form_with(model: @overtime_request,
              url: @overtime_request.persisted? ? user_overtime_request_path(@user, @overtime_request) : user_overtime_requests_path(@user),
              local: false,
              id: "overtime_request_form",
              data: { action: "submit->overtime-request#submit" }) do |f| %>
  <table class="table table-bordered">
    <thead>
      <tr>
        <th>日付</th>
        <th>曜日</th>
        <th>終了予定時間</th>
        <th>翌日</th>
        <th>業務処理内容</th>
        <th>指示者確認印</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= l(@overtime_request.worked_on, format: :short) %></td>
        <td><%= $days_of_the_week[@overtime_request.worked_on.wday] %></td>
        <td>
          <%= f.hidden_field :worked_on %>
          <span class="time-select">
            <%= f.select :finished_hour, hour_options, {}, class: "form-control input-sm" %>
            :
            <%= f.select :finished_minute, minute_options, {}, class: "form-control input-sm" %>
          </span>
        </td>
        <td><%= f.check_box :finishes_next_day %></td>
        <td><%= f.text_field :content, class: "form-control" %></td>
        <td>
          <%= f.collection_select :approver_id, approvers, :id, :name, {}, class: "form-control" %>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>
<% content_for :modal_footer do %>
  <%= submit_tag "変更を送信する", form: "overtime_request_form", class: "btn btn-primary btn-block" %>
  <% if @overtime_request.persisted? && @overtime_request.pending? %>
    <%= link_to "この申請を取り消す", user_overtime_request_path(@user, @overtime_request),
          data: { turbo_method: :delete, turbo_confirm: "この残業申請を取り消しますか？" },
          class: "btn btn-default btn-block" %>
  <% end %>
<% end %>
