<% provide(:title, '出勤社員一覧') %>
<h1>出勤社員一覧</h1>

<div class="col-md-8 col-md-offset-2">
  <% if @working_attendances.empty? %>
    <p class="text-center text-muted">現在出勤中の社員はいません。</p>
  <% else %>
    <table class="table table-bordered table-condensed" id="table-working-users">
      <thead>
        <tr>
          <th><%= User.human_attribute_name :employee_number %></th>
          <th><%= User.human_attribute_name :name %></th>
          <th>出社時間</th>
        </tr>
      </thead>
      <tbody>
        <% @working_attendances.each do |attendance| %>
          <tr>
            <td><%= attendance.user.employee_number %></td>
            <td><%= attendance.user.name %></td>
            <td><%= attendance.started_at.strftime("%H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
