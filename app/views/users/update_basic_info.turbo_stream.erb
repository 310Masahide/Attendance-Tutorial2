<% if @user.errors.any? %>
  <%= turbo_stream.replace 'modal' do %>
    <%= render partial: 'users/edit_basic_info', locals: { user: @user } %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@user) do %>
    <%= render partial: 'users/user_row', locals: { user: @user } %>
  <% end %>
  <%= turbo_stream.update 'modal', '' %>
<% end %>

<%= turbo_stream.update 'flash', partial: 'shared/flash_messages' %>
