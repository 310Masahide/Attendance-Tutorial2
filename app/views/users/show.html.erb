<% provide(:title, @user.name) %>
<% readonly = params[:readonly].present? %>
<div>
  <table class="table table-bordered table-condensed user-table">
    <tr>
      <td>
        <% unless readonly %>
          <%= link_to "⇦", user_path(date: @first_day.prev_month), class: "btn btn-primary btn-sm" %>
        <% end %>
        【<%= l(@first_day, format: :middle) %>】勤怠管理表
        <% unless readonly %>
          <%= link_to "⇨", user_path(date: @first_day.next_month), class: "btn btn-primary btn-sm" %>
        <% end %>
      </td>
      <td>
          指定勤務開始時間：<%= format_basic_info(@user.designated_work_start_time) %><br>
          指定勤務終了時間：<%= format_basic_info(@user.designated_work_end_time) %>
      </td>
      <td colspan="3">基本時間：<%= format_basic_info(@user.basic_time) %></td>
      <td>初日：<%= l(@first_day, format: :short) %></td>
    </tr>
    <tr>
      <td>所属：<%= @user.department.present? ? @user.department : "未所属" %></td>
      <td>氏名：<%= @user.name %></td>
      <td>コード</td>
      <td>ー</td>
      <td>出勤日数：<%= @worked_sum %>日</td>
      <td>締め：<%= l(@last_day, format: :short) %></td>
    </tr>
  </table>
</div>
<% (attendance_correction_notices_for(current_user) + overtime_notices_for(current_user)).each do |notice| %>
  <%= render 'users/overtime_notice', notice: notice %>
<% end %>

<% unless readonly %>
  <div class="btn-users-show">
    <%= link_to "勤怠を編集", attendances_edit_one_month_user_path(date: @first_day), class: "btn btn-primary" %>
  </div>
<% end %>

<div>
  <table class="table table-bordered table-condensed table-hover" id="table-attendances">

    <% shows_overtime_request_column = !current_user.admin? && !readonly %>

    <% result_columns   = 7 %><%# 出社2 + 退社2 + 在社時間 + 備考 + 指示者確認印 %>
    <% overtime_columns = 5 %><%# 終了予定2 + 時間外時間 + 業務処理内容 + 指示者確認印 %>
    <% total_columns    = 2 + result_columns + overtime_columns %><%# 日付+曜日 + 【実績】+ 所定外勤務(残業申請列は別枠なので含まない) %>

    <thead>
      <tr>
        <% if shows_overtime_request_column %>
          <th class="col-overtime-request" rowspan="3">残業申請</th>
        <% end %>
        <th rowspan="3">日付</th>
        <th rowspan="3">曜日</th>
        <th colspan="<%= result_columns %>">【実績】</th>
        <th colspan="<%= overtime_columns %>">所定外勤務</th>
      </tr>
      <tr>
        <th colspan="2">出社</th>
        <th colspan="2">退社</th>
        <th rowspan="2">在社時間</th>
        <th rowspan="2">備考</th>
        <th rowspan="2">指示者確認印</th>
        <th colspan="2">終了予定時間</th>
        <th rowspan="2">時間外時間</th>
        <th rowspan="2">業務処理内容</th>
        <th rowspan="2">指示者確認印</th>
      </tr>
      <tr>
        <th>時</th>
        <th>分</th>
        <th>時</th>
        <th>分</th>
        <th>時</th>
        <th>分</th>
      </tr>
    </thead>
    <tbody>
      <% @attendances.each do |attendance| %>
        <% overtime_request = @overtime_requests_by_date[attendance.worked_on] %>
        <% correction_request = attendance.latest_correction_request %>
        <% pending_request = correction_request if correction_request&.pending? %>
        <% display_started  = pending_request&.requested_started_at  || attendance.started_at %>
        <% display_finished = pending_request&.requested_finished_at || attendance.finished_at %>
        <% correction_result_line = if correction_request&.decided?
                                       correction_request.result_label
                                     elsif correction_request&.pending?
                                       "#{correction_request.approver.name}：勤怠変更申請中"
                                     end %>
        <% overtime_result_line = overtime_request&.status_label %>
        <tr>
          <% if shows_overtime_request_column %>
            <%= render 'users/overtime_request_cell',
                  worked_on: attendance.worked_on,
                  overtime_request: overtime_request %>
          <% end %>
          <td><%= l(attendance.worked_on, format: :short) %></td>
          <td><%= $days_of_the_week[attendance.worked_on.wday] %></td>
          <td><%= display_started&.strftime("%H") %></td>
          <td><%= display_started&.strftime("%M") %></td>
          <td><%= display_finished&.strftime("%H") %></td>
          <td><%= display_finished&.strftime("%M") %></td>
          <td>
            <% if attendance.started_at.present? && attendance.finished_at.present? %>
              <% str_times = working_times(attendance.started_at, attendance.finished_at) %>
              <% @total_working_times = @total_working_times.to_f + str_times.to_f %>
            <% end %>
            <% if display_started.present? && display_finished.present? %>
              <%= working_times(display_started, display_finished) %>
            <% end %>
          </td>
          <td><%= pending_request&.note || attendance.note %></td>
          <td><%= correction_result_line %></td>
          <td><%= format("%02d", overtime_request.finished_hour) if overtime_request %></td>
          <td><%= format("%02d", overtime_request.finished_minute) if overtime_request %></td>
          <td><%= format("%.2f", overtime_request.overtime_hours) if overtime_request %></td>
          <td><%= overtime_request&.content %></td>
          <td><%= overtime_result_line %></td>
        </tr>
      <% end %>
    </tbody>

    <tfoot>
      <!--rowspan:縦結合、colspan：横結合-->
      <tr>
        <% if shows_overtime_request_column %>
          <td rowspan="2"></td>
        <% end %>
        <td colspan="2">累計日数</td>
        <td colspan="2">総合勤務時間</td>
        <td colspan="2">累計在社時間</td>
        <td colspan="<%= total_columns - 6 %>" rowspan="2"></td>
      </tr>
      <tr>
        <td colspan="2"><%= @attendances.count %></td>
        <td colspan="2"><%= format_basic_info(@user.work_time).to_f * @worked_sum %></td>
        <td colspan="2"><%= format("%.2f",@total_working_times.to_f) %></td>
      </tr>
    </tfoot>
  </table>
</div>