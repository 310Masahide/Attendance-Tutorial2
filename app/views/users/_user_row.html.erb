<div id="<%= dom_id(user) %>" class="user-list-item">
  <p class="user-list-name"><%= user.name %></p>
  <p>
    |
    <%= link_to "削除", user,
          data: { turbo_method: :delete, turbo_confirm: "#{user.name}を削除してよろしいですか？" },
          class: "btn btn-primary btn-sm" %>
  </p>
  <div class="user-edit-panel">
    <%= link_to "編集", edit_basic_info_user_path(user),
          data: { turbo_frame: 'modal' }, class: "btn btn-primary btn-lg" %>
  </div>
</div>
