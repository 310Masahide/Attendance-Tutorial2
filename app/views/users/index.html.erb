<% provide(:title, 'All Users') %>
<h1>ユーザー一覧</h1>

<div class="col-md-10 col-md-offset-1">
  <div class="users-import">
    <%= form_with url: import_users_path, data: { turbo: false, controller: "file-name" } do |f| %>
      <div class="users-import-file">
        <label class="btn btn-default users-import-select">
          ファイルを選択
          <%= f.file_field :file, accept: ".csv", class: "users-import-input",
                data: { file_name_target: "input", action: "change->file-name#show" } %>
        </label>
        <input type="text" class="form-control users-import-name" readonly
               data-file-name-target="name">
      </div>
      <%= f.submit "CSVをインポート", class: "btn btn-primary btn-block" %>
    <% end %>
  </div>

  <%= will_paginate @users, params: { controller: "users", action: "index" } %>
  <div id="user-list">
    <%= render partial: 'users/user_row', collection: @users, as: :user %>
  </div>
  <%= will_paginate @users, params: { controller: "users", action: "index" } %>
</div>
