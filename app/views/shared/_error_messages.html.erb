<% if object.errors.any? %>
  <div id="error_explanation">
    <div class="alert alert-danger">
      入力エラー<%= object.errors.count %>件ありました。
    </div>
    <ul>
    <% object.errors.full_messages.each do |error_message| %>
      <li><%= error_message %></li>
    <% end %>
    </ul>
  </div>
<% end %>