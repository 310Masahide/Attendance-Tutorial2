<% if requests_by_applicant.blank? %>
  <p class="text-center text-muted">未処理の残業申請はありません。</p>
<% else %>
  <%= form_with url: bulk_update_received_overtime_requests_user_path(supervisor),
                method: :patch, local: false,
                id: "bulk_update_form",
                data: { action: "submit->modal#submit" } do %>
    <% requests_by_applicant.each do |applicant, overtime_requests| %>
      <h2 class="applicant-name"><%= applicant.name %> さんからの申請</h2>
      <table class="table table-bordered notice-table">
        <thead>
          <tr>
            <th>日付</th>
            <th>曜日</th>
            <th>終了予定時間</th>
            <th>指定勤務終了時間</th>
            <th>時間外時間</th>
            <th class="text-center">業務処理内容</th>
            <th>指示者確認印</th>
            <th>変更</th>
            <th>勤怠を確認する</th>
          </tr>
        </thead>
        <tbody>
          <% overtime_requests.each do |overtime_request| %>
            <tr>
              <td><%= l(overtime_request.worked_on, format: :short) %></td>
              <td><%= $days_of_the_week[overtime_request.worked_on.wday] %></td>
              <td><%= format("%02d:%02d", overtime_request.finished_hour, overtime_request.finished_minute) %></td>
              <td><%= overtime_request.scheduled_finish_time&.strftime("%H.%M") %></td>
              <td><%= format("%.2f", overtime_request.overtime_hours) %></td>
              <td><%= overtime_request.content %></td>
              <td>
                <%= select_tag "overtime_requests[#{overtime_request.id}][status]",
                      options_for_select(OvertimeRequest.status_options, overtime_request.status),
                      class: "form-control" %>
              </td>
              <td>
                <%= check_box_tag "overtime_requests[#{overtime_request.id}][apply]", "1" %>
              </td>
              <td>
                <%= link_to "確認",
                      user_path(applicant, date: overtime_request.worked_on.beginning_of_month, readonly: true),
                      data: { turbo_frame: "_top" },
                      class: "btn btn-primary btn-block" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
  <% content_for :modal_footer do %>
    <%= submit_tag "変更を送信する", form: "bulk_update_form", class: "btn btn-primary btn-block" %>
  <% end %>
<% end %>
